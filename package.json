{
  "name": "@versatiles/server",
  "version": "1.8.0",
  "description": "A server for VersaTiles",
  "bin": {
    "versatiles-server": "./dist/index.js"
  },
  "prefix": "./",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "static"
  ],
  "scripts": {
    "build": "npm run build-node && npm run doc",
    "build-node": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"fs.chmodSync('dist/index.js', 0o755)\"",
    "check": "npm run lint && npm run build && npm run test",
    "dev": "tsx src/index.ts -o https://download.versatiles.org/osm-vector/osm-vector.versatiles https://download.versatiles.org/satellite-raster/satellite-raster.versatiles",
    "doc": "npm run doc-command && npm run doc-graph",
    "doc-command": "vrt doc-command versatiles-server | vrt doc-insert README.md '## Options'",
    "doc-graph": "vrt deps-graph | vrt doc-insert README.md '## Dependency Graph'",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint . --color",
    "prepack": "npm run build",
    "release": "vrt release-npm",
    "start": "tsx src/index.ts",
    "test-coverage": "vitest --run --coverage",
    "test-smoke": "tsx scripts/smoke-test.ts",
    "test": "vitest --run",
    "update-frontend": "./scripts/update-frontend.sh",
    "upgrade": "vrt deps-upgrade"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/versatiles-org/node-versatiles-server.git"
  },
  "homepage": "https://github.com/versatiles-org/node-versatiles-server#readme",
  "type": "module",
  "author": "yetzt <node@yetzt.me>, Michael Kreil <versatiles@michael-kreil.de>",
  "license": "Unlicense",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/versatiles-org"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/versatiles"
    }
  ],
  "engines": {
    "node": ">= 22.15"
  },
  "keywords": [
    "cloudtiles",
    "geo",
    "gis",
    "map",
    "maps",
    "mapserver",
    "maptiles",
    "mvt",
    "opencloudtiles",
    "osm",
    "pbf",
    "tile",
    "tiles",
    "tileserver",
    "vectortiles",
    "versatiles"
  ],
  "dependencies": {
    "@versatiles/container": "^2.1.2",
    "@versatiles/style": "^9.1.0",
    "commander": "^15.1.0",
    "open": "^11.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@versatiles/release-tool": "^2.22.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
